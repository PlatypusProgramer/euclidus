---
// Canvas component for Euclidus geometry visualization
---

<div id="canvas-container" style="width: 100%; height: calc(100vh - 100px); background-color: #1a1a1a;"></div>

<script>
  import * as PIXI from 'pixi.js';
  
  interface Point {
    label: string;
    x: number;
    y: number;
    graphics?: PIXI.Graphics;
    text?: PIXI.Text;
  }
  
  class CanvasManager {
    app!: PIXI.Application;
    points: Map<string, Point> = new Map();
    container: HTMLElement;
    
    constructor(container: HTMLElement) {
      this.container = container;
    }
    
    async init() {
      this.app = new PIXI.Application();
      await this.app.init({
        width: this.container.clientWidth,
        height: this.container.clientHeight,
        backgroundColor: 0x1a1a1a,
        antialias: true,
      });
      
      this.container.appendChild(this.app.canvas as HTMLCanvasElement);
      
      // Center the stage at canvas center with (0,0) at center
      this.app.stage.position.x = this.app.canvas.width / 2;
      this.app.stage.position.y = this.app.canvas.height / 2;
      this.app.stage.scale.y = -1; // Flip Y axis so positive Y goes up
      
      // Handle window resize
      window.addEventListener('resize', () => this.resize());
    }
    
    resize() {
      const width = this.container.clientWidth;
      const height = this.container.clientHeight;
      this.app.renderer.resize(width, height);
      
      // Recenter stage
      this.app.stage.position.x = this.app.canvas.width / 2;
      this.app.stage.position.y = this.app.canvas.height / 2;
    }
    
    addPoint(label: string, x: number, y: number) {
      // Remove existing point if it exists
      if (this.points.has(label)) {
        this.removePoint(label);
      }
      
      // Create point object
      const point: Point = { label, x, y };
      
      // Draw orange dot
      const graphics = new PIXI.Graphics();
      graphics.circle(x, y, 6);
      graphics.fill({ color: 0xff8c00 }); // Nice orange
      this.app.stage.addChild(graphics);
      point.graphics = graphics;
      
      // Add label
      const text = new PIXI.Text({
        text: label,
        style: {
          fontSize: 16,
          fill: 0xffffff,
          fontWeight: 'bold',
        },
      });
      text.x = x + 12;
      text.y = y - 12;
      text.scale.y = -1; // Flip text back to normal orientation
      this.app.stage.addChild(text);
      point.text = text;
      
      // Store point
      this.points.set(label, point);
      
      console.log(`Added point ${label} at (${x}, ${y})`);
    }
    
    removePoint(label: string) {
      const point = this.points.get(label);
      if (point) {
        if (point.graphics) {
          this.app.stage.removeChild(point.graphics);
        }
        if (point.text) {
          this.app.stage.removeChild(point.text);
        }
        this.points.delete(label);
      }
    }
    
    getAllPoints() {
      return Array.from(this.points.values());
    }
  }
  
  // Initialize canvas
  const container = document.getElementById('canvas-container');
  if (container) {
    const canvas = new CanvasManager(container);
    await canvas.init();
    
    // Expose to window for CLI to access
    (window as any).canvasManager = canvas;
  }
</script>

<style>
  #canvas-container {
    overflow: hidden;
  }
</style>

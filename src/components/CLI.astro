---
// CLI Input component for Euclidus
---

<div id="cli-container" style="background-color: #0d0d0d; border-top: 1px solid #333; padding: 10px; font-family: monospace; display: flex; flex-direction: column; height: 100%; width: 100%; box-sizing: border-box;">
  <div id="cli-output" style="color: #888; font-size: 12px; margin-bottom: 8px; overflow-y: auto; flex: 1;">
    <div style="color: #ffa500;">Euclidus CLI Ready. Type commands (e.g., "new point A 0,0")</div>
  </div>
  <div style="display: flex; gap: 8px; flex-shrink: 0;">
    <span style="color: #ffa500; line-height: 1.5;"></span>
    <input 
      id="cli-input" 
      type="text" 
      placeholder="new point A 0,0"
      style="
        flex: 1;
        background-color: #1a1a1a;
        border: none;
        color: #fff;
        font-family: monospace;
        font-size: 14px;
        padding: 8px;
        outline: none;
      "
    />
  </div>
</div>

<script>
  import { parseCommand } from '../application/CommandParser';
  import type { GeometryEngine } from '../application/GeometryEngine';
  const input = document.getElementById('cli-input') as HTMLInputElement;
  const output = document.getElementById('cli-output') as HTMLDivElement;
  
  function addLog(message: string, type: 'info' | 'error' | 'success' = 'info') {
    const div = document.createElement('div');
    let color = '#888';
    if (type === 'error') color = '#ff4444';
    if (type === 'success') color = '#44ff44';
    if (type === 'info') color = '#888';
    
    div.style.color = color;
    div.textContent = message;
    output.appendChild(div);
    output.scrollTop = output.scrollHeight;
    
    // Keep last 10 messages
    while (output.children.length > 10) {
      output.removeChild(output.children[0]);
    }
  }
  
  function executeCommand(command: string) {
    if (!command.trim()) return;
    
    addLog(`> ${command}`);
    const parsed = parseCommand(command);

    if (parsed.type === 'invalid') {
      addLog(`Invalid command. ${parsed.reason}`, 'error');
      return;
    }

    const app = (window as any).euclidus as { engine?: GeometryEngine } | undefined;
    if (!app?.engine) {
      addLog('Engine not initialized', 'error');
      return;
    }

    try {
      if (parsed.type === 'addPoint') {
        app.engine.addPoint(parsed.name, parsed.x, parsed.y);
        addLog(`Created point ${parsed.name} at (${parsed.x}, ${parsed.y})`, 'success');
      }
      if (parsed.type === 'addLineSegment') {
        app.engine.addLineSegment(parsed.name, parsed.start, parsed.end);
        addLog(`Created line segment ${parsed.name} between ${parsed.start} and ${parsed.end}`, 'success');
      }
      if (parsed.type === 'addLine') {
        app.engine.addLine(parsed.name, parsed.root, parsed.directionX, parsed.directionY);
        addLog(
          `Created line ${parsed.name} through ${parsed.root} with direction (${parsed.directionX}, ${parsed.directionY})`,
          'success'
        );
      }
      if (parsed.type === 'lockPoint') {
        app.engine.lockPoint(parsed.name);
        addLog(`Locked point ${parsed.name}`, 'success');
      }
      if (parsed.type === 'unlockPoint') {
        app.engine.unlockPoint(parsed.name);
        addLog(`Unlocked point ${parsed.name}`, 'success');
      }
      if (parsed.type === 'addPerpendicular') {
        app.engine.addPerpendicularConstraint(parsed.a, parsed.b);
        const aLabel = `${parsed.a.type === 'line' ? 'line' : 'segment'} ${parsed.a.name}`;
        const bLabel = `${parsed.b.type === 'line' ? 'line' : 'segment'} ${parsed.b.name}`;
        addLog(`Added perpendicular constraint between ${aLabel} and ${bLabel}`, 'success');
      }
    } catch (error) {
      addLog(`Error: ${error instanceof Error ? error.message : 'Unknown error'}`, 'error');
    }
  }
  
  input.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') {
      executeCommand(input.value);
      input.value = '';
    }
  });
  
  // Expose logging for canvas messages
  (window as any).addLog = addLog;
</script>

<style>
  #cli-output {
    font-size: 12px;
  }
</style>

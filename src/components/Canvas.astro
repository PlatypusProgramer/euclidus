---
// Canvas component for Euclidus geometry visualization
---

<div id="canvas-container" style="width: 100%; height: 100%; background-color: #1a1a1a;"></div>

<script>
  import { CanvasRenderer } from '../rendering/CanvasRenderer';
  import { GeometryEngine } from '../application/GeometryEngine';
  
  // Initialize canvas
  const container = document.getElementById('canvas-container');
  if (container) {
    // Expose a placeholder so the CLI can report status while we initialize.
    (window as any).euclidus = { engine: undefined };
    const renderer = new CanvasRenderer(container);
    const debugEnabled = new URLSearchParams(window.location.search).has('debug');
    const debugLines: string[] = [];
    const debug = (line: string) => {
      if (!debugEnabled) return;
      debugLines.push(line);
      console.info(line);
      const panel = document.getElementById('debug-panel');
      if (panel) panel.textContent = debugLines.join('\n');
    };
    if (debugEnabled && !document.getElementById('debug-panel')) {
      const panel = document.createElement('pre');
      panel.id = 'debug-panel';
      panel.style.position = 'fixed';
      panel.style.right = '12px';
      panel.style.top = '12px';
      panel.style.maxWidth = '40vw';
      panel.style.maxHeight = '40vh';
      panel.style.overflow = 'auto';
      panel.style.background = 'rgba(0,0,0,0.75)';
      panel.style.color = '#00ff7f';
      panel.style.padding = '10px';
      panel.style.fontSize = '11px';
      panel.style.zIndex = '9999';
      panel.style.whiteSpace = 'pre-wrap';
      panel.style.border = '1px solid #0f0';
      panel.textContent = 'Debug enabled...\n';
      document.body.appendChild(panel);
    }
    const initOnce = async () => {
      debug('initOnce: start');
      const warnTimer = window.setTimeout(() => {
        console.warn('Renderer init is taking longer than expected...');
        if (typeof (window as any).addLog === 'function') {
          (window as any).addLog('Renderer is still initializing, please wait...', 'info');
        }
        debug('warnTimer fired (init still running)');
      }, 8000);

      try {
        debug('renderer.init() starting');
        await renderer.init();
        debug('renderer.init() done');
        const engine = new GeometryEngine(renderer);
        debug('GeometryEngine created');
        renderer.setPointDragHandler((name, x, y) => engine.updatePoint(name, x, y));

        // Expose to window for CLI to access
        (window as any).euclidus = { engine };
        debug('window.euclidus.engine set');

        engine.addPoint('A', 0, 0);
        engine.addPoint('B', 15, 15);
        engine.addLineSegment('AB', 'A', 'B');
        debug('seed geometry added');
      } catch (error) {
        console.error('Canvas init failed:', error);
        debug(`init error: ${error instanceof Error ? error.message : 'Unknown error'}`);
        if (typeof (window as any).addLog === 'function') {
          const message = error instanceof Error ? error.message : 'Unknown error';
          (window as any).addLog(`Canvas init failed: ${message}`, 'error');
        }
      } finally {
        window.clearTimeout(warnTimer);
        debug('initOnce: finished');
      }
    };

    const waitForSize = async () => {
      debug('waitForSize: start');
      while (container.clientWidth === 0 || container.clientHeight === 0) {
        debug(`waitForSize: size=${container.clientWidth}x${container.clientHeight}`);
        await new Promise((resolve) => requestAnimationFrame(() => resolve(null)));
      }
      debug(`waitForSize: done size=${container.clientWidth}x${container.clientHeight}`);
    };

    const start = async () => {
      debug(`start: document.readyState=${document.readyState}`);
      debug(`start: devicePixelRatio=${window.devicePixelRatio}`);
      debug(`start: userAgent=${navigator.userAgent}`);
      await waitForSize();
      await initOnce();
    };

    if (document.readyState === 'complete') {
      debug('readyState=complete -> start now');
      start();
    } else {
      window.addEventListener('load', () => {
        debug('window load event -> start');
        start();
      }, { once: true });
    }
  }
</script>

<style>
  #canvas-container {
    overflow: hidden;
  }
</style>

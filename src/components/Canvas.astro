---
// Canvas component for Euclidus geometry visualization
---

<div id="canvas-container" style="width: 100%; height: 100%; background-color: #1a1a1a;"></div>

<script>
  import { CanvasRenderer } from '../rendering/CanvasRenderer';
  import { GeometryEngine } from '../application/GeometryEngine';
  
  // Initialize canvas
  const container = document.getElementById('canvas-container');
  if (container) {
    // Expose a placeholder so the CLI can report status while we initialize.
    (window as any).euclidus = { engine: undefined };
    const renderer = new CanvasRenderer(container);
    const initOnce = async () => {
      const warnTimer = window.setTimeout(() => {
        console.warn('Renderer init is taking longer than expected...');
        if (typeof (window as any).addLog === 'function') {
          (window as any).addLog('Renderer is still initializing, please wait...', 'info');
        }
      }, 8000);

      try {
        await renderer.init();
        const engine = new GeometryEngine(renderer);
        renderer.setPointDragHandler((name, x, y) => engine.updatePoint(name, x, y));

        // Expose to window for CLI to access
        (window as any).euclidus = { engine };

        // Right triangle and square outlines for a Pythagoras-style scene.
        engine.addPoint('A', 0, 0);
        engine.addPoint('B', 20, 0);
        engine.addPoint('C', 0, 15);
        engine.addFixedPointConstraint('A', 0, 0);

        // Square on AB (side length 20).
        engine.addPoint('D', 20, -20);
        engine.addPoint('E', 0, -20);

        // Square on AC (side length 15).
        engine.addPoint('F', -15, 0);
        engine.addPoint('G', -15, 15);

        // Square on BC (side length 25).
        engine.addPoint('H', 35, 20);
        engine.addPoint('I', 15, 35);

        // Triangle edges.
        engine.addLineSegment('AB', 'A', 'B');
        engine.addLineSegment('AC', 'A', 'C');
        engine.addLineSegment('BC', 'B', 'C');

        // Square AB outline.
        engine.addLineSegment('BD', 'B', 'D');
        engine.addLineSegment('DE', 'D', 'E');
        engine.addLineSegment('EA', 'E', 'A');

        // Square AC outline.
        engine.addLineSegment('AF', 'A', 'F');
        engine.addLineSegment('FG', 'F', 'G');
        engine.addLineSegment('GC', 'G', 'C');

        // Square BC outline.
        engine.addLineSegment('BH', 'B', 'H');
        engine.addLineSegment('HI', 'H', 'I');
        engine.addLineSegment('IC', 'I', 'C');

        // Constraints: right triangle at A.
        engine.addPerpendicularConstraint(
          { type: 'lineSegment', name: 'AB' },
          { type: 'lineSegment', name: 'AC' }
        );

        // Constraints: square on AB (parallel pairs).
        engine.addParallelConstraint(
          { type: 'lineSegment', name: 'AB' },
          { type: 'lineSegment', name: 'DE' }
        );
        engine.addParallelConstraint(
          { type: 'lineSegment', name: 'BD' },
          { type: 'lineSegment', name: 'EA' }
        );
        engine.addPerpendicularConstraint(
          { type: 'lineSegment', name: 'AB' },
          { type: 'lineSegment', name: 'BD' }
        );
        engine.addEqualLengthConstraint('AB', 'BD');
        engine.addEqualLengthConstraint('AB', 'EA');
        engine.addEqualLengthConstraint('AB', 'DE');

        // Constraints: square on AC (parallel pairs).
        engine.addParallelConstraint(
          { type: 'lineSegment', name: 'AF' },
          { type: 'lineSegment', name: 'GC' }
        );
        engine.addParallelConstraint(
          { type: 'lineSegment', name: 'AC' },
          { type: 'lineSegment', name: 'FG' }
        );
        engine.addPerpendicularConstraint(
          { type: 'lineSegment', name: 'AC' },
          { type: 'lineSegment', name: 'AF' }
        );
        engine.addEqualLengthConstraint('AC', 'AF');
        engine.addEqualLengthConstraint('AC', 'GC');
        engine.addEqualLengthConstraint('AC', 'FG');

        // Constraints: square on BC (parallel pairs).
        engine.addParallelConstraint(
          { type: 'lineSegment', name: 'BC' },
          { type: 'lineSegment', name: 'HI' }
        );
        engine.addParallelConstraint(
          { type: 'lineSegment', name: 'BH' },
          { type: 'lineSegment', name: 'IC' }
        );
        engine.addPerpendicularConstraint(
          { type: 'lineSegment', name: 'BC' },
          { type: 'lineSegment', name: 'BH' }
        );
        engine.addEqualLengthConstraint('BC', 'BH');
        engine.addEqualLengthConstraint('BC', 'IC');
        engine.addEqualLengthConstraint('BC', 'HI');
      } catch (error) {
        console.error('Canvas init failed:', error);
        if (typeof (window as any).addLog === 'function') {
          const message = error instanceof Error ? error.message : 'Unknown error';
          (window as any).addLog(`Canvas init failed: ${message}`, 'error');
        }
      } finally {
        window.clearTimeout(warnTimer);
      }
    };

    const waitForSize = async () => {
      while (container.clientWidth === 0 || container.clientHeight === 0) {
        await new Promise((resolve) => requestAnimationFrame(() => resolve(null)));
      }
    };

    const start = async () => {
      await waitForSize();
      await initOnce();
    };

    if (document.readyState === 'complete') {
      start();
    } else {
      window.addEventListener('load', () => {
        start();
      }, { once: true });
    }
  }
</script>

<style>
  #canvas-container {
    overflow: hidden;
  }
</style>

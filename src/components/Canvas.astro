---
// Canvas component for Euclidus geometry visualization
---

<div id="canvas-container" style="width: 100%; height: 100%; background-color: #1a1a1a;"></div>

<script>
  import { CanvasRenderer } from '../rendering/CanvasRenderer';
  import { GeometryEngine } from '../application/GeometryEngine';
  
  // Initialize canvas
  const container = document.getElementById('canvas-container');
  if (container) {
    // Expose a placeholder so the CLI can report status while we initialize.
    (window as any).euclidus = { engine: undefined };
    const renderer = new CanvasRenderer(container);
    const initOnce = async () => {
      const warnTimer = window.setTimeout(() => {
        console.warn('Renderer init is taking longer than expected...');
        if (typeof (window as any).addLog === 'function') {
          (window as any).addLog('Renderer is still initializing, please wait...', 'info');
        }
      }, 8000);

      try {
        await renderer.init();
        const engine = new GeometryEngine(renderer);
        renderer.setPointDragHandler((name, x, y) => engine.updatePoint(name, x, y));

        // Expose to window for CLI to access
        (window as any).euclidus = { engine };

        engine.addPoint('A', 0, 0);
        engine.addPoint('B', 15, 15);
        engine.addLineSegment('AB', 'A', 'B');
      } catch (error) {
        console.error('Canvas init failed:', error);
        if (typeof (window as any).addLog === 'function') {
          const message = error instanceof Error ? error.message : 'Unknown error';
          (window as any).addLog(`Canvas init failed: ${message}`, 'error');
        }
      } finally {
        window.clearTimeout(warnTimer);
      }
    };

    const waitForSize = async () => {
      while (container.clientWidth === 0 || container.clientHeight === 0) {
        await new Promise((resolve) => requestAnimationFrame(() => resolve(null)));
      }
    };

    const start = async () => {
      await waitForSize();
      await initOnce();
    };

    if (document.readyState === 'complete') {
      start();
    } else {
      window.addEventListener('load', () => {
        start();
      }, { once: true });
    }
  }
</script>

<style>
  #canvas-container {
    overflow: hidden;
  }
</style>

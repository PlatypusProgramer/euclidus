---
// Canvas component for Euclidus geometry visualization
---

<div id="canvas-shell">
  <div id="canvas-container" style="width: 100%; height: 100%; background-color: #1a1a1a;"></div>
  <button id="clear-scene-btn" type="button" title="Clear scene" disabled>Clear</button>
</div>

<script>
  import { CanvasRenderer } from '../rendering/CanvasRenderer';
  import { GeometryEngine } from '../application/GeometryEngine';
  
  // Initialize canvas
  const container = document.getElementById('canvas-container');
  if (container) {
    const clearButton = document.getElementById('clear-scene-btn') as HTMLButtonElement | null;
    // Expose a placeholder so the CLI can report status while we initialize.
    (window as any).euclidus = { engine: undefined, selection: undefined };
    const renderer = new CanvasRenderer(container);
    const initOnce = async () => {
      const warnTimer = window.setTimeout(() => {
        console.warn('Renderer init is taking longer than expected...');
        if (typeof (window as any).addLog === 'function') {
          (window as any).addLog('Renderer is still initializing, please wait...', 'info');
        }
      }, 8000);

      try {
        await renderer.init();
        const engine = new GeometryEngine(renderer);
        renderer.setSelectionMoveHandler((updates) => {
          engine.updatePointsById(updates);
        });
        renderer.setSelectionDeleteHandler((selectedIds) => {
          const result = engine.deleteEntitiesById(selectedIds);
          if (typeof (window as any).addLog === 'function') {
            (window as any).addLog(
              `Deleted ${result.points} points, ${result.lines} lines, ${result.lineSegments} segments, ${result.constraints} constraints`,
              'info'
            );
          }
        });
        const selection = renderer.getSelectionApi();

        // Expose to window for CLI to access
        (window as any).euclidus = { engine, selection };
        if (clearButton) {
          clearButton.disabled = false;
          clearButton.addEventListener('click', () => {
            engine.clear();
            if (typeof (window as any).addLog === 'function') {
              (window as any).addLog('Cleared all points, lines, segments, and constraints', 'info');
            }
          });
        }

        // Simple starter scene:
        // - two parallel line segments
        // - two perpendicular lines
        // - two equal-length line segments

        // Parallel segments: AB || CD
        engine.addPoint('A', -16, 14);
        engine.addPoint('B', -4, 14);
        engine.addPoint('C', -16, 8);
        engine.addPoint('D', -4, 8);
        engine.addLineSegment('AB', 'A', 'B');
        engine.addLineSegment('CD', 'C', 'D');
        engine.addParallelConstraint(
          { type: 'lineSegment', name: 'AB' },
          { type: 'lineSegment', name: 'CD' }
        );

        // Perpendicular lines: L1 ⟂ L2
        engine.addPoint('E', 4, 2);
        engine.addPoint('F', 14, 2);
        engine.addPoint('G', 9, -5);
        engine.addPoint('H', 9, 9);
        engine.addLine('L1', 'E', 'F');
        engine.addLine('L2', 'G', 'H');
        engine.addPerpendicularConstraint(
          { type: 'line', name: 'L1' },
          { type: 'line', name: 'L2' }
        );

        // Equal-length segments: IJ == KL
        engine.addPoint('I', -12, -8);
        engine.addPoint('J', -6, -8);
        engine.addPoint('K', 2, -10);
        engine.addPoint('L', 8, -10);
        engine.addLineSegment('IJ', 'I', 'J');
        engine.addLineSegment('KL', 'K', 'L');
        engine.addEqualLengthConstraint('IJ', 'KL');
      } catch (error) {
        console.error('Canvas init failed:', error);
        if (clearButton) {
          clearButton.disabled = true;
        }
        if (typeof (window as any).addLog === 'function') {
          const message = error instanceof Error ? error.message : 'Unknown error';
          (window as any).addLog(`Canvas init failed: ${message}`, 'error');
        }
      } finally {
        window.clearTimeout(warnTimer);
      }
    };

    const waitForSize = async () => {
      while (container.clientWidth === 0 || container.clientHeight === 0) {
        await new Promise((resolve) => requestAnimationFrame(() => resolve(null)));
      }
    };

    const start = async () => {
      await waitForSize();
      await initOnce();
    };

    if (document.readyState === 'complete') {
      start();
    } else {
      window.addEventListener('load', () => {
        start();
      }, { once: true });
    }
  }
</script>

<style>
  #canvas-shell {
    position: relative;
    width: 100%;
    height: 100%;
  }

  #clear-scene-btn {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 30;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 999px;
    padding: 8px 14px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #f6f6f6;
    background: linear-gradient(160deg, rgba(24, 24, 24, 0.92), rgba(10, 10, 10, 0.92));
    backdrop-filter: blur(6px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.35);
    cursor: pointer;
    transition: transform 120ms ease, border-color 120ms ease, background-color 120ms ease;
  }

  #clear-scene-btn:hover {
    transform: translateY(-1px);
    border-color: rgba(255, 186, 89, 0.8);
    background: linear-gradient(160deg, rgba(42, 35, 24, 0.94), rgba(20, 16, 10, 0.94));
  }

  #clear-scene-btn:active {
    transform: translateY(0);
  }

  #clear-scene-btn:disabled {
    cursor: default;
    opacity: 0.45;
    transform: none;
  }

  #canvas-container {
    overflow: hidden;
  }
</style>

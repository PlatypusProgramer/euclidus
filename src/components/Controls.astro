---
// Grid and Canvas controls component
---

<div id="controls-container" style="background-color: #0d0d0d; border-bottom: 1px solid #333; padding: 12px; display: flex; gap: 20px; align-items: center; font-family: monospace; font-size: 12px;">
  <div style="display: flex; gap: 8px; align-items: center;">
    <label style="color: #888;">Grid Size (px/unit):</label>
    <input 
      id="grid-size-input"
      type="number"
      value="25"
      min="5"
      max="100"
      step="5"
      style="
        background-color: #1a1a1a;
        border: 1px solid #333;
        color: #fff;
        padding: 4px 8px;
        width: 60px;
        font-family: monospace;
      "
    />
  </div>
  
  <div style="display: flex; gap: 8px; align-items: center;">
    <label style="color: #888;">Pan X:</label>
    <input 
      id="pan-x-input"
      type="number"
      value="0"
      step="10"
      style="
        background-color: #1a1a1a;
        border: 1px solid #333;
        color: #fff;
        padding: 4px 8px;
        width: 70px;
        font-family: monospace;
      "
    />
  </div>
  
  <div style="display: flex; gap: 8px; align-items: center;">
    <label style="color: #888;">Pan Y:</label>
    <input 
      id="pan-y-input"
      type="number"
      value="0"
      step="10"
      style="
        background-color: #1a1a1a;
        border: 1px solid #333;
        color: #fff;
        padding: 4px 8px;
        width: 70px;
        font-family: monospace;
      "
    />
  </div>
  
  <button id="reset-view-btn" style="
    background-color: #ff8c00;
    color: #000;
    border: none;
    padding: 6px 12px;
    cursor: pointer;
    font-family: monospace;
    font-weight: bold;
    border-radius: 3px;
  ">Reset View</button>
</div>

<script>
  const gridSizeInput = document.getElementById('grid-size-input') as HTMLInputElement;
  const panXInput = document.getElementById('pan-x-input') as HTMLInputElement;
  const panYInput = document.getElementById('pan-y-input') as HTMLInputElement;
  const resetBtn = document.getElementById('reset-view-btn') as HTMLButtonElement;
  
  function updateCanvasSettings() {
    const settings = {
      gridSize: parseFloat(gridSizeInput.value) || 25,
      panX: parseFloat(panXInput.value) || 0,
      panY: parseFloat(panYInput.value) || 0,
    };
    
    const canvasManager = (window as any).canvasManager;
    if (canvasManager) {
      canvasManager.updateGridSettings(settings);
    }
  }
  
  gridSizeInput.addEventListener('change', updateCanvasSettings);
  gridSizeInput.addEventListener('input', updateCanvasSettings);
  panXInput.addEventListener('change', updateCanvasSettings);
  panXInput.addEventListener('input', updateCanvasSettings);
  panYInput.addEventListener('change', updateCanvasSettings);
  panYInput.addEventListener('input', updateCanvasSettings);
  
  resetBtn.addEventListener('click', () => {
    gridSizeInput.value = '25';
    panXInput.value = '0';
    panYInput.value = '0';
    updateCanvasSettings();
  });
  
  // Expose for canvas to update when programmatically changed
  (window as any).updateControlsDisplay = (settings: any) => {
    gridSizeInput.value = settings.gridSize.toString();
    panXInput.value = settings.panX.toString();
    panYInput.value = settings.panY.toString();
  };
</script>
